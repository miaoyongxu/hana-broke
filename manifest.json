{
  "manifestVersion": 2,
  "id": "hana-broke",
  "name": "Hana Broke",
  "version": "0.9.0",
  "entry": "index.js",
  "description": "装这一个插件，就把你已登录的订阅——WorkBuddy / WorkBuddy AI、Qoder、OpenCode Zen——全部接进 HanaAgent。供应商是来自 magpie 社区的可安装插件，不需要额外装任何程序。",
  "capabilities": [
    "app/process.spawn"
  ],
  "network": {
    "allowedHosts": [
      "127.0.0.1",
      "localhost"
    ],
    "allowLocalhost": true,
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "defaultTimeoutMs": 120000,
    "maxResponseBytes": 8388608
  },
  "contributes": {
    "cards": [
      {
        "id": "panel",
        "title": "Hana Broke",
        "description": "控制台：登录每个供应商、看它列出的模型、逐个显示或隐藏，以及把结果同步进 HanaAgent。",
        "route": "/panel.html",
        "cardForm": "structural",
        "realization": "page",
        "siteNavEntry": true,
        "face": {
          "image": "assets/cover.svg"
        }
      }
    ]
  },
  "icon": "assets/icon.svg",
  "minAppVersion": "1.1.0-beta"
}

